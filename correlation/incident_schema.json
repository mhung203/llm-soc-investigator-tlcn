{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOC Rule-Based Correlated Incident Group",
  "description": "Incident output created from rule-based correlation. Ground Truth and experiment run IDs are not correlation inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "scenario",
    "start_time",
    "end_time",
    "entities",
    "timeline",
    "evidence_event_ids",
    "correlation_explanation",
    "limitations"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "enum": [
        "ssh_brute_force",
        "http_data_exfiltration"
      ]
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src_ip": {
          "type": [
            "string",
            "null"
          ]
        },
        "dst_ip": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "sshd_pids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "flow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "security_event_type",
          "role",
          "event_ids"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "security_event_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary",
              "supporting"
            ]
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "sshd_pid": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "enum": [
              "request",
              "response",
              "unknown",
              null
            ]
          },
          "link_basis": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "correlation_explanation": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
